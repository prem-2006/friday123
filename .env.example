# OpenDots template: the UI opens in setup state until these fields are configured.
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/opendots.sqlite
# Keep OWNER_ID stable: it owns the persistent Intelligence conversations.
OWNER_ID=opendots-owner
# npm run dev allows http://localhost:5173 and http://127.0.0.1:5173.
# APP_ORIGIN replaces these defaults with comma-separated exact origins.
# Include scheme, hostname and port; omit paths and trailing slashes.
# APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Required for an external HOST binding (24+ characters); enables local login too.
# OWNER_TOKEN=

# `copilotkit project select` or `local connect` writes CPK_INTELLIGENCE_API_KEY.
# The server accepts either name and prefers a non-empty CPK_INTELLIGENCE_API_KEY.
INTELLIGENCE_API_KEY=
# INTELLIGENCE_API_URL=
# `local connect` writes this endpoint; it takes precedence over the legacy name.
# INTELLIGENCE_GATEWAY_WS_URL=
# INTELLIGENCE_WS_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Maximum duration for Dot turns and scheduled/background agent runs (milliseconds).
# AGENT_RUN_TIMEOUT_MS=90000
# Keep the CLI-generated CPK_TELEMETRY_ID with its matching project key.
# The SDK uses it to connect OpenDots usage to the Intelligence account.
# CPK_TELEMETRY_ID=
# SDK usage telemetry is enabled by default (separate from conversations).
# See docs/TELEMETRY.md for signup reporting and validation.
# Optional sampling override (default 1):
# COPILOTKIT_TELEMETRY_SAMPLE_RATE=1
# Either flag below opts out:
# COPILOTKIT_TELEMETRY_DISABLED=true
# DO_NOT_TRACK=1

# Optional isolated read-only public-page browser for WEB_SEARCH_PROVIDER=browser.
BROWSER_URL=http://127.0.0.1:4311
BROWSER_SECRET=
BROWSER_HOST=127.0.0.1
BROWSER_PORT=4311
# Use the same random 24+ character secret in app/browser. All redirects are blocked.
# Supply canonical public URLs. Use the separate browser container for isolation.

# Optional connected apps through Composio; see docs/SETUP.md#composio.
COMPOSIO_API_KEY=

# Optional realtime speech; compute uses the same configured Intelligence thread.
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin

# Optional managed Slack channel; see docs/SETUP.md#slack.
# Match the managed declaration name, not a Slack #conversation name.
# OpenTag calls this INTELLIGENCE_CHANNEL_NAME; OpenDots uses SLACK_CHANNEL_NAME.
# Allowlist both the Slack workspace and explicit Slack user IDs.
SLACK_CHANNEL_NAME=
SLACK_TEAM_ID=
SLACK_USER_IDS=
# SLACK_DOT_ID= (defaults to the initial Dot)

# Optional persistent computers, one per Dot, using OpenBot services.
# See docs/COMPUTERS.md. Keep these two different random secrets on the server.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Keep stable: the namespace identifies existing containers and persistent volumes.
COMPUTER_NAMESPACE=opendots
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# ENGINE_SOCKET=/var/run/docker.sock

# --- FRIDAY -------------------------------------------------------------
# Gnani Evon is Friday's planner. When EVON_BASE_URL is set, these three
# replace OPENAI_API_KEY, OPENAI_BASE_URL and OPENAI_MODEL above.
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL=gnani-evon-v3.3
# Gnani speech: Prisma (speech-to-text) and Timbre (text-to-speech).
GNANI_API_KEY=
# Friday's own phone calls through Exotel (an Indian number): Friday places
# and answers calls itself with Prisma, Evon and Timbre, and the owner can get
# things done on the call. Once EXOTEL_API_KEY is set these are used instead
# of Twilio and Sarvam (FRIDAY_CALL_PROVIDER=twilio switches back).
# On my.exotel.com: API settings has the key, token and account SID; your
# ExoPhone is EXOTEL_CALLER_ID. In App Bazaar make a call flow with a
# Voicebot applet, then a Hangup applet, and put its id (in the flow's URL)
# in EXOTEL_APP_ID. The Voicebot's URL is wss://<NGROK_DOMAIN>/exotel/stream?key=<EXOTEL_STREAM_KEY>
# (the services print it at start). Set the ExoPhone's incoming calls to the
# same flow. Exotel may need to switch on Voicebot (AgentStream) for you:
# ask hello@exotel.com. A trial calls only numbers verified on my.exotel.com.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_CALLER_ID=
EXOTEL_APP_ID=
# A random value of 20+ characters; it proves the audio stream is Exotel's.
EXOTEL_STREAM_KEY=
# api.in.exotel.com for an India account (the default), api.exotel.com for Singapore.
EXOTEL_SUBDOMAIN=
FRIDAY_CALL_PROVIDER=
# Phone calls through Twilio (when Exotel is not set up).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# HTTPS tunnel (ngrok or cloudflared) that reaches friday/services, for Twilio.
PUBLIC_URL=
# The owner's time zone, for "today", "tomorrow" and "this evening".
TIMEZONE=Asia/Kolkata
# Your name, used when Friday introduces itself on calls and in messages.
FRIDAY_OWNER_NAME=
# friday/services: a random 24+ character secret that OpenDots sends as the
# bearer token for Friday's MCP connections. Port of the services process.
FRIDAY_SERVICES_TOKEN=
FRIDAY_SERVICES_PORT=8765
# Keep 127.0.0.1: Navigator's browser and Operator's apps run on this PC.
FRIDAY_SERVICES_HOST=127.0.0.1
# Demo calendar Navigator can fill in. Default: http://127.0.0.1:<port>/calendar
FRIDAY_CALENDAR_URL=
# Evon thinks before answering by default, which is too slow for calls. Set to
# false if your Evon endpoint rejects chat_template_kwargs.
EVON_DISABLE_THINKING=true
# Extra model request options as JSON. For Gemini, skip thinking for fast
# voice replies: FRIDAY_MODEL_OPTIONS='{"reasoning_effort":"none"}'
FRIDAY_MODEL_OPTIONS=
# Retries when the model is rate limited (free plans): 0-6, default 3.
FRIDAY_MODEL_RETRIES=3
# A phone call lasts minutes: allow long turns and enough tool rounds.
AGENT_RUN_TIMEOUT_MS=600000
FRIDAY_MAX_TOOL_ROUNDS=24
# A backup model, used at once when the main one answers "too many requests"
# (HTTP 429/503). Any OpenAI-compatible endpoint, e.g. OpenRouter:
# FRIDAY_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# FRIDAY_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free
FRIDAY_FALLBACK_BASE_URL=
FRIDAY_FALLBACK_API_KEY=
FRIDAY_FALLBACK_MODEL=
# How long one helper tool may run (the browser agent works through several
# pages in one call). Milliseconds, 10000 to 900000.
FRIDAY_TOOL_TIMEOUT_MS=300000
# Navigator's browser agent (friday/browser-agent, run `uv sync` there once).
# It uses the EVON_* model unless these are set. Each step is one model call.
FRIDAY_BROWSER_MODEL=
FRIDAY_BROWSER_BASE_URL=
FRIDAY_BROWSER_API_KEY=
# Model for look_at_screen (needs image input); defaults to EVON_MODEL.
FRIDAY_VISION_MODEL=
# Friday calls you (deadlines, "call me at 5"). Needs the TWILIO_* settings and
# cloudflared (winget install Cloudflare.cloudflared): the services open a free
# tunnel by themselves and only the /twilio/ call routes are reachable through
# it. A Twilio trial account can call only numbers verified in its console.
# Your number: Your details on the main page, or here (+91...).
FRIDAY_OWNER_PHONE=
# Better: calls to you through Gnani's Inya voice agent (an Indian call, no
# trial notice, and Friday talks with you live). Make an API key with the
# "agents" permission in the Inya console and whitelist your number there
# (Phone Numbers -> Whitelisted). Friday uses the agent named Friday, or makes
# one; INYA_AGENT_ID picks another. With Inya set, a missed call to the Twilio
# number makes Friday ring you back with your updates.
INYA_API_KEY=
INYA_AGENT_ID=
INYA_ENVIRONMENT=development
# Or calls to you through a Sarvam voice agent (used first when all are set,
# unless Exotel is: then Sarvam is only the fallback),
# all from indus.sarvam.ai: the workspace API key, Org ID and Workspace ID
# (Settings); the agent's ID (last part of its address while editing it) and
# its committed version number; your Sarvam number and its connection ID
# (Deploy -> Phone Numbers). The agent's greeting must be {{opening_line}};
# its instructions can use {{reason}} and {{updates}}.
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_NUMBER=
SARVAM_CALL_LANGUAGE=English
# Call Friday's Sarvam number and it does what you say (see friday/README.md,
# "Call Friday"). Sarvam's agent reaches Friday at a fixed ngrok address: the
# authtoken and the free static domain from dashboard.ngrok.com. The agent's
# ask_friday tool sends FRIDAY_PHONE_TOKEN as its bearer token; only calls from
# your own number get anything done. Exotel's Voicebot needs this fixed
# address too.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
FRIDAY_PHONE_TOKEN=
# off: keep the TWILIO_* settings but never use Twilio (calls only through Sarvam).
FRIDAY_TWILIO=on
FRIDAY_CALL_LANGUAGE=en-IN
# Also ring you 1 hour and 15 minutes before a deadline, and when it is due.
FRIDAY_CALL_DEADLINES=true
# off: never open the tunnel (set PUBLIC_URL yourself instead).
FRIDAY_TUNNEL=cloudflared
# Hold Caps Lock to talk (any app). Claps and "Hey Friday" are off for now; true turns them on.
# Clap twice to open Friday's screen.
FRIDAY_PUSH_TO_TALK=true
FRIDAY_CLAP_WAKE=false
# How loud a clap must be (0 to 1); lower it if claps are not noticed.
FRIDAY_CLAP_LEVEL=0.25
# "Hey Friday" wake word, heard on this PC by a small offline model (downloaded once, ~36 MB).
FRIDAY_WAKE_WORD=false
# On "Hey Friday" or a double clap, Friday says hello about the window in front, then listens.
FRIDAY_WAKE_GREETING=true
# Background research reports: the Obscura binary (default friday/obscura/obscura.exe) and
# the vault they are saved in (default data/friday-obsidian).
FRIDAY_OBSCURA_PATH=
FRIDAY_OBSIDIAN_VAULT=
# Navigator's engine for multi-step browser jobs: auto (Hermes Agent when
# friday/hermes-agent is installed), hermes, or browser-use.
FRIDAY_BROWSER_AGENT=auto
# Hermes's model; empty uses FRIDAY_BROWSER_* and then EVON_*.
FRIDAY_HERMES_BASE_URL=
FRIDAY_HERMES_API_KEY=
FRIDAY_HERMES_MODEL=
# Learned shortcuts and "When I say X, ..." voice shortcuts (data/friday-shortcuts.json).
FRIDAY_LEARN=true
# Opened by a double clap when the voice screen is closed.
FRIDAY_STAGE_URL=http://localhost:5173/#/friday
# true: open Friday's own Chrome when the services start (quicker first web task). Off by default.
FRIDAY_BROWSER_PREWARM=false
# Chrome's debugging port for the on-screen window (127.0.0.1 only).
FRIDAY_BROWSER_CDP_PORT=9333
# --- END FRIDAY ---------------------------------------------------------

# Public-web provider. parallel (default), browser (URL-only), or disabled.
# Queries and selected URLs are sent to Parallel; sample mode makes no provider calls.
WEB_SEARCH_PROVIDER=parallel
# Optional Bearer key for production/higher limits; anonymous MCP supports light use.
PARALLEL_API_KEY=
